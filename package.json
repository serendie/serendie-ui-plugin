{
  "name": "serendie-design-linter",
  "version": "1.0.0",
  "description": "A Figma plugin to lint Serendie Design System",
  "scripts": {
    "build:fetch": "node scripts/fetch-documents.js",
    "build:plugin": "esbuild plugin-src/code.ts --bundle --outfile=dist/plugin.js --target=es2017 --format=iife --external:figma",
    "build:ui": "esbuild ui-src/index.tsx --bundle --outfile=dist/ui.js --target=es2020 --format=iife --loader:.tsx=tsx",
    "build:html": "node ui-src/build-html.mjs",
    "build:panda": "panda codegen",
    "build": "run-s build:panda build:fetch build:plugin build:ui build:html",
    "lint": "eslint --ext .ts,.tsx --ignore-pattern node_modules .",
    "lint:fix": "eslint --ext .ts,.tsx --ignore-pattern node_modules --fix .",
    "format": "eslint --ext .ts,.tsx --ignore-pattern node_modules --fix . && prettier --write .",
    "tsc": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "watch:plugin": "esbuild plugin-src/code.ts --bundle --outfile=dist/plugin.js --target=es2017 --format=iife --external:figma --watch",
    "watch:ui": "esbuild ui-src/index.tsx --bundle --outfile=dist/ui.js --target=es2020 --format=iife --loader:.tsx=tsx --watch",
    "watch:html": "nodemon --watch dist/ui.js --exec npm run build:html",
    "watch": "run-p watch:*"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@figma/widget-typings": "*",
    "@pandacss/dev": "^1.2.0",
    "@types/jest": "^30.0.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "esbuild": "*",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.2",
    "typescript": "^5.3.2"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "ignorePatterns": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "scripts/**",
      "widget-src/**",
      "styled-system/**",
      "panda.config.ts",
      "*.config.js"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.42",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@serendie/design-token": "^1.2.0",
    "@serendie/ui": "^2.1.3",
    "ai": "^5.0.59",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  }
}
