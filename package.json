{
  "name": "spread-system-widget",
  "version": "1.0.0",
  "description": "Your Figma widget",
  "scripts": {
    "build:fetch": "node scripts/fetch-documents.js",
    "build:bundle": "esbuild widget-src/code.tsx --bundle --outfile=dist/code.js --target=es6",
    "build": "run-s build:fetch build:bundle",
    "lint": "eslint --ext .ts,.tsx --ignore-pattern node_modules .",
    "lint:fix": "eslint --ext .ts,.tsx --ignore-pattern node_modules --fix .",
    "format": "eslint --ext .ts,.tsx --ignore-pattern node_modules --fix . && prettier --write .",
    "tsc": "tsc --noEmit -p widget-src",
    "watch": "npm run build:bundle -- --watch"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@figma/widget-typings": "*",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "esbuild": "*",
    "eslint": "^8.54.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5.3.2"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./widget-src/tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  },
  "dependencies": {
    "@serendie/design-token": "^1.2.0",
    "openai": "^5.16.0",
    "zod": "^3.25.76"
  }
}
