{
  "compilerOptions": {
    "jsx": "react",
    "jsxFactory": "figma.widget.h",
    "jsxFragmentFactory": "figma.widget.Fragment",
    "target": "es2016",
    "lib": ["es2016"],
    "strict": true,
    "moduleResolution": "bundler",
    "typeRoots": ["../node_modules/@types", "../node_modules/@figma"],
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/*.mdx"]
}
